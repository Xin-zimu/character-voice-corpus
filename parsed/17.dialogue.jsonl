{"ep": "17", "idx": 348, "start": "0:22:28.76", "end": "0:22:30.37", "style": "zhengwen", "actor": "NTP", "text": "等…等等啊  春日！"}
{"ep": "17", "idx": 349, "start": "0:22:33.62", "end": "0:22:35.13", "style": "zhengwen", "actor": "NTP", "text": "又来了  这既视感"}
{"ep": "17", "idx": 350, "start": "0:22:36.02", "end": "0:22:38.53", "style": "zhengwen", "actor": "NTP", "text": "而且还前所未有地强烈"}
